# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Copiez ce fichier en .env.local et mettez vos propres valeurs. Ne commitez jamais .env.local.

# Supabase → Project Settings → API Keys (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# OpenRouter → https://openrouter.ai/settings/keys — secret, only used on the server
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Any model from https://openrouter.ai/models that supports response_format
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optional: the model that reads notebook photos (must accept images)
# OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash
